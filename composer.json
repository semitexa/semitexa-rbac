{
    "name": "semitexa/rbac",
    "description": "Semitexa RBAC - role-based access control with roles, grants, and permission assignment",
    "type": "semitexa-module",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "semitexa/core": "*",
        "semitexa/authorization": "*"
    },
    "autoload": {
        "psr-4": {
            "Semitexa\\Rbac\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Semitexa\\Rbac\\Tests\\": "tests/"
        }
    },
    "extra": {
        "semitexa-module": {
            "extends": null
        },
        "semitexa": {
            "floors": {
                "semitexa/core": "next"
            }
        }
    },
    "keywords": [
        "semitexa",
        "rbac",
        "roles",
        "permissions",
        "grants"
    ]
}
